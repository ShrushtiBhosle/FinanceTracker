@model FinanceTracker.Models.FinanceDashboardViewModel

@{
    ViewData["Title"] = "Finance Dashboard";
}

<div class="container mt-4 mb-5">

    <!-- Dashboard Heading -->
    <div class="mb-4">
        <h1 class="fw-bold">
            My Finance Dashboard 💰
        </h1>

        <p class="text-muted">
            Track your income, expenses and financial balance.
        </p>
    </div>

    <!-- Financial Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Income -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Income</h6>

                    <h2 class="text-success fw-bold">
                        ₹@Model.TotalIncome.ToString("N2")
                    </h2>

                    <p class="mb-0 small">
                        Your recorded earnings
                    </p>
                </div>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Expenses</h6>

                    <h2 class="text-danger fw-bold">
                        ₹@Model.TotalExpenses.ToString("N2")
                    </h2>

                    <p class="mb-0 small">
                        Your recorded spending
                    </p>
                </div>
            </div>
        </div>

        <!-- Available Balance -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Available Balance</h6>

                    <h2 class="text-primary fw-bold">
                        ₹@Model.Balance.ToString("N2")
                    </h2>

                    <p class="mb-0 small">
                        Income minus expenses
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Navigation Buttons -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <a asp-controller="Incomes"
               asp-action="Index"
               class="btn btn-success w-100 py-2">
                💰 Manage Income
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Expenses"
               asp-action="Index"
               class="btn btn-primary w-100 py-2">
                💸 Manage Expenses
            </a>
        </div>

    </div>

    <!-- Charts -->
    <div class="row g-4">

        <!-- Income vs Expenses Chart -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="text-center mb-4">
                        Income vs Expenses
                    </h5>

                    <div style="height:300px; position:relative;">
                        <canvas id="incomeExpenseChart"></canvas>
                    </div>

                </div>

            </div>
        </div>

        <!-- Expense Categories Chart -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="text-center mb-4">
                        Expense Categories
                    </h5>

                    <div style="height:300px; position:relative;">
                        <canvas id="expenseCategoryChart"></canvas>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <!-- Financial Summary -->
    <div class="card shadow-sm border-0 mt-4">

        <div class="card-body">

            <h5 class="fw-bold">
                Financial Summary
            </h5>

            @if (Model.Balance > 0)
            {
                <p class="text-success mb-0">
                    Great job! Your recorded income is greater than your expenses.
                </p>
            }
            else if (Model.Balance < 0)
            {
                <p class="text-danger mb-0">
                    Your recorded expenses exceed your income.
                    Consider reviewing your spending.
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    Your recorded income and expenses are equal.
                </p>
            }

        </div>

    </div>

</div>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Income vs Expenses Bar Chart

    const incomeExpenseCanvas =
        document.getElementById('incomeExpenseChart');

    new Chart(incomeExpenseCanvas, {
        type: 'bar',

        data: {
            labels: ['Income', 'Expenses', 'Balance'],

            datasets: [{
                label: 'Amount (₹)',

                data: [
                    @Model.TotalIncome,
                    @Model.TotalExpenses,
                    @Model.Balance
                ],

                backgroundColor: [
                    '#198754',
                    '#dc3545',
                    '#0d6efd'
                ],

                borderWidth: 1
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: false
                },

                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return '₹' +
                                context.parsed.y.toLocaleString('en-IN');
                        }
                    }
                }
            },

            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });


    // Expense Categories Pie Chart

    const categoryLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ExpenseCategories.Keys
        )
    );

    const categoryAmounts = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ExpenseCategories.Values
        )
    );

    const expenseCategoryCanvas =
        document.getElementById('expenseCategoryChart');

    new Chart(expenseCategoryCanvas, {
        type: 'pie',

        data: {
            labels: categoryLabels,

            datasets: [{
                label: 'Expenses (₹)',

                data: categoryAmounts,

                backgroundColor: [
                    '#0d6efd',
                    '#dc3545',
                    '#ffc107',
                    '#198754',
                    '#6f42c1',
                    '#fd7e14',
                    '#20c997',
                    '#6c757d'
                ],

                borderWidth: 1
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    position: 'bottom'
                },

                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ₹' +
                                Number(context.raw).toLocaleString('en-IN');
                        }
                    }
                }
            }
        }
    });
</script>